{
  "manifest_version": 3,
  "name": "UIU eLMS Watcher",
  "short_name": "eLMS Watcher",
  "version": "1.2.0",
  "description": "Watches UIU eLMS announcements and upcoming assignments, with due-date countdowns and reminders.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  
  "background": {
    "scripts": [
      "offscreen.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://elms.uiu.ac.bd/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "UIU eLMS Watcher",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
