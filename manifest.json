{
  "manifest_version": 3,
  "name": "UIU eLMS Announcement Watcher",
  "short_name": "eLMS Watcher",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Automatically discovers UIU eLMS courses, checks Announcements forums, and notifies you about new posts.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://elms.uiu.ac.bd/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://elms.uiu.ac.bd/my/courses.php*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "UIU eLMS Announcement Watcher",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
